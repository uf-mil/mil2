<root BTCPP_format="4">
    <!--
        S2 (CALIBRATION-FREE): descend until the down-cam sees the table, then
        center over it with vision. Needs NO pool-specific dead-reckon constants
        (unlike OctagonTableMission) and does NO pinger homing / NO grasp, so it is
        reusable by both the pinger-homed OctagonRestoreMission and the
        OctagonMission capstone. It works whether the sub arrived via S1 acoustic
        homing or was hand-placed above the octagon.

        DetectTarget can FAIL (table drifted off-frame after descent), so the
        SearchForTarget spiral fallback is actually reachable; HoneOverTarget then
        degrades gracefully (always succeeds) and downstream stages re-center
        themselves before acting. min_area_frac="0.15" is what makes that true:
        the model emits a confident corner phantom 'table' in ~every frame, so
        without an area floor all three presence checks read "table in frame"
        forever and the spiral is dead code. See detection_gate.hpp.
    -->
    <BehaviorTree ID="AcquireTable">
        <Sequence>
            <!-- min_conf 0.20 is a temporary value to get Task 5 working in sim
                 while the YOLO model is being retrained. Once the model is good,
                 make confidence 0.80 or higher, most likely. min_area_frac does
                 the real discrimination meanwhile. -->
            <!-- Descend step-by-step until the table appears on the down cam. -->
            <DescendUntilDetected label="table" camera="down" min_conf="0.20" min_area_frac="0.15"
                                  step_m="0.20" max_steps="12"
                                  timeout_msec="45000" ctx="{ctx}"/>
            <!-- Make sure the table is in frame; spiral-search if it drifted off. -->
            <Fallback>
                <DetectTarget label="table" camera="down" min_conf="0.20" min_area_frac="0.15" ctx="{ctx}"/>
                <SearchForTarget label="table" camera="down" min_conf="0.20" min_area_frac="0.15"
                                 step_m="0.30" max_radius_m="2.0"
                                 timeout_msec="60000" ctx="{ctx}"/>
            </Fallback>
            <!-- Center over the table with the world-frame lock (LockOverTarget)
                 rather than the incremental pixel hone: the table lies exactly on
                 the cast plane (table_z), so the absolute-goal, level-holding lock
                 removes the pitch-latch/moving-setpoint divergence that made the
                 old CenterCamera hone drift off and starve SelectTarget. Degrades
                 gracefully if unseen. table_z is the tabletop world z. -->
            <SubTree ID="LockOverTarget" _autoremap="true"
                     label="table" camera="down" select="largest"
                     min_conf="0.20" min_area_frac="0.15"
                     table_z="-0.85" tol_world="0.05" timeout_msec="20000" miss_frames="5" ctx="{ctx}"/>
        </Sequence>
    </BehaviorTree>
</root>
