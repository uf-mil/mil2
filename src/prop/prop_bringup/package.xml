<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prop_bringup</name>
  <version>0.0.0</version>
  <description>Launches the prop boat: drivers, localization, perception, planning and control.</description>
  <maintainer email="c.chavez@ufl.edu">Carlos Chavez</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Everything boat.launch.py includes. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pcd</exec_depend>
  <exec_depend>prop_controller</exec_depend>
  <exec_depend>prop_localization</exec_depend>
  <exec_depend>prop_planner</exec_depend>
  <exec_depend>prop_thrusters</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
