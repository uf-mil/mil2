<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pcd</name>
  <version>0.0.0</version>
  <description>
    Point-cloud filtering and Euclidean clustering for the prop platform.
    Reads raw VLP-16 / PointCloud2 data, rejects water-surface returns and
    out-of-range points, then segments the scene into discrete object clusters.
  </description>
  <maintainer email="mohanashree.pamidimukkala@gmail.com">mohana</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>libpcl-all-dev</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
