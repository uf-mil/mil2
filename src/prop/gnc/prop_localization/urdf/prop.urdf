<?xml version="1.0"?>
<!-- Frames only: what the EKFs and perception need to place the sensors on the
     hull. The simulated hull lives in prop_gazebo/xacro/prop.sdf.xacro and
     mounts its sensors at these same poses. -->
<robot name="prop">
  <link name="base_link"/>
  <link name="imu"/>
  <link name="lidar_link"/>

  <!-- The IMU is mounted backwards on the boat, hence the yaw of pi. -->
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu"/>
    <origin xyz="0.422165 -0.349025 -0.069291" rpy="0 0 3.141592653589793"/>
  </joint>

  <!-- On top of the mast, clear of the hull. Same height as the VLP-16 in
       prop_gazebo/xacro/prop.sdf.xacro. -->
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.67" rpy="0 0 0"/>
  </joint>

  <link name="camera_link"/>
  <link name="camera_optical_frame"/>

  <!-- TODO measure: a stand-in until the camera's mount is. prop_fusion
       projects the lidar's tracks through it, so yaw here is a bearing error
       on every label. -->
  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
  </joint>

  <!-- z forward, x right, y down: the frame image pixels are in. -->
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
</robot>
