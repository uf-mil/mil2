<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>prop_mission_planner</name>
  <version>0.0.0</version>
  <description>
    Behavior-tree mission runner for the boat. Runs XML missions that chain
    the prop_maneuvers maneuvers in-process. Same structure and user
    experience as the sub's mission_planner.
  </description>
  <maintainer email="daviddgonzalez56@gmail.com">david</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>prop_maneuvers</depend>
  <depend>rclcpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
