<?xml version="1.0"?>
<package format="3">
  <name>prop_planner</name>
  <version>0.0.0</version>
  <description>Continuous visibility-graph planning using a persistent obstacle map.</description>
  <maintainer email="zhuen.zhong@ufl.edu">Zhuen Zhong</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>nav_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>tf2_ros_py</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
