<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- SDF <inertial> block for a solid cylinder spun about its Z axis. -->
  <xacro:macro name="inertial_cylinder" params="mass length radius">
    <inertial>
      <mass>${mass}</mass>
      <inertia>
        <ixx>${(mass / 12.0) * (3 * radius * radius + length * length)}</ixx>
        <iyy>${(mass / 12.0) * (3 * radius * radius + length * length)}</iyy>
        <izz>${(mass / 2.0) * (radius * radius)}</izz>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyz>0</iyz>
      </inertia>
    </inertial>
  </xacro:macro>
</sdf>
