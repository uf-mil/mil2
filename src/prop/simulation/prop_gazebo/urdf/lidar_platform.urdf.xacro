<?xml version="1.0"?>
<robot name="lidar_platform" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find prop_gazebo)/urdf/components/vlp16_lidar.xacro"/>

  <!-- Pin the whole model in place: no gravity fall, no buoyancy/water interaction -->
  <gazebo>
    <static>true</static>
  </gazebo>

  <!-- Bare root link, no chassis geometry/mass: just an anchor for the sensor -->
  <link name="base_link"/>

  <xacro:vlp16_lidar parent="base_link" xyz="0 0 0" rpy="0 0 0"/>

  <!-- Static buoy targets for perception/clustering validation -->
  <xacro:macro name="buoy" params="name xyz radius:='0.2' length:='2.0' rgba:='0.9 0.15 0.15 1.0'">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${name}_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Tall buoys placed in front of the lidar sensor in the water -->
  <!-- Red buoy (port marker) -->
  <xacro:buoy name="red_buoy" xyz="3.5 -1.2 0.0" radius="0.2" length="2.0" rgba="0.9 0.15 0.15 1.0"/>
  <!-- Green buoy (starboard marker) -->
  <xacro:buoy name="green_buoy" xyz="5.5 1.5 0.0" radius="0.2" length="2.2" rgba="0.15 0.85 0.2 1.0"/>
  <!-- Yellow marker buoy -->
  <xacro:buoy name="yellow_buoy" xyz="7.0 -0.3 0.0" radius="0.22" length="2.0" rgba="0.95 0.85 0.1 1.0"/>
</robot>
