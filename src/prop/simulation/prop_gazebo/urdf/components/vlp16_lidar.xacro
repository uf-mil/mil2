<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find prop_gazebo)/urdf/macros/inertial.xacro"/>

  <!--
    Velodyne VLP-16 lidar mounted on a parent link.

    VLP-16 specs:
      - 16 vertical beams
      - +/-15 deg vertical FOV
      - 360 deg horizontal FOV
      - 10 Hz update rate
  -->
  <xacro:macro
    name="vlp16_lidar"
    params="parent:=chassis
            xyz:='0.1 0 0.175'
            rpy:='0 0 0'
            update_rate:=10
            horizontal_samples:=1875
            max_range:=100.0
            noise_stddev:=0.01"
  >
    <joint name="laser_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="laser_frame"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="laser_frame">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.05"/>
        </geometry>
        <material name="laser_material">
          <color rgba="0.13 0.13 0.13 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.05"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <gazebo reference="laser_frame">
      <sensor type="gpu_lidar" name="vlp16_sensor">
        <topic>lidar</topic>
        <frame_id>laser_frame</frame_id>
        <update_rate>${update_rate}</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>${horizontal_samples}</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${noise_stddev}</stddev>
          </noise>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
